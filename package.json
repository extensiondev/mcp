{
  "name": "@extension.dev/mcp",
  "type": "module",
  "version": "11.0.0",
  "description": "extension.dev MCP is the MCP server for building browser extensions. Build, run, debug, test and ship Chrome, Firefox, Edge and Safari extensions from your AI agent.",
  "mcpName": "io.github.extensiondev/mcp",
  "license": "Apache-2.0",
  "author": {
    "name": "Cezar Augusto",
    "email": "hello@extension.dev",
    "url": "https://cezaraugusto.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extensiondev/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/extensiondev/mcp/issues"
  },
  "homepage": "https://extension.dev",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.19.0",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./clients": {
      "types": "./dist/src/clients/index.d.ts",
      "import": "./dist/clients.js"
    },
    "./kernel": {
      "types": "./dist/src/kernel.d.ts",
      "import": "./dist/kernel.js"
    }
  },
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "bin": {
    "extension-mcp": "bin/extension-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "claude",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "docs:tools": "WRITE_TOOLS_DOC=1 vitest run src/__tests__/docs-match-the-code.test.ts",
    "readme:clients": "UPDATE_README=1 vitest run src/__tests__/readme-clients.test.ts",
    "compile": "rslib build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 184",
    "lint:fast": "eslint . --report-unused-disable-directives --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:files": "eslint --quiet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/__tests__/tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "agents",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "github-copilot",
    "codex",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-extension",
    "safari-web-extension",
    "chrome-web-store",
    "firefox-add-ons",
    "edge-add-ons",
    "safari",
    "publish",
    "manifest-v3",
    "webextension",
    "cross-browser",
    "developer-tools",
    "extension.dev",
    "extension.js"
  ],
  "dependencies": {
    "@extension.dev/urls": "^0.8.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "acorn": "^8.19.0",
    "cross-spawn": "^7.0.6",
    "extension-create": "4.1.41",
    "extension-develop": "4.1.41",
    "extension-install": "4.1.41",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.19.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "eslint-config-auditor": "^3.0.0",
    "globals": "^17.7.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  }
}
