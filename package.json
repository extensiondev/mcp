{
  "name": "@extension.dev/mcp",
  "type": "module",
  "version": "10.11.1",
  "description": "MCP server that lets AI agents (Claude Code, Claude Desktop, Cursor, Copilot, Codex) build, run, inspect, and publish browser extensions. 32 tools for scaffolding, live DOM inspection, log streaming, and store-ready builds across Chrome, Edge, Firefox, Safari, and every Chromium- or Gecko-based browser (Brave, Opera, Vivaldi, Yandex, Waterfox, Zen, Floorp). Powered by extension.dev and Extension.js.",
  "mcpName": "io.github.extensiondev/mcp",
  "license": "Apache-2.0",
  "author": {
    "name": "Cezar Augusto",
    "email": "hello@extension.dev",
    "url": "https://cezaraugusto.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extensiondev/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/extensiondev/mcp/issues"
  },
  "homepage": "https://extension.dev",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.19.0",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./clients": {
      "types": "./dist/src/clients/index.d.ts",
      "import": "./dist/clients.js"
    }
  },
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "bin": {
    "extension-mcp": "./bin/extension-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "claude",
    ".claude-plugin",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "docs:tools": "WRITE_TOOLS_DOC=1 vitest run src/__tests__/docs-match-the-code.test.ts",
    "readme:clients": "UPDATE_README=1 vitest run src/__tests__/readme-clients.test.ts",
    "compile": "rslib build",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/__tests__/tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "agents",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "github-copilot",
    "codex",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-extension",
    "safari-web-extension",
    "manifest-v3",
    "webextension",
    "cross-browser",
    "developer-tools",
    "extension.dev",
    "extension.js"
  ],
  "dependencies": {
    "@extension.dev/urls": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "^7.0.6",
    "extension-create": "4.1.32",
    "extension-develop": "4.1.33",
    "extension-install": "4.1.32",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.19.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "eslint-config-auditor": "^3.0.0",
    "globals": "^17.7.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  }
}
